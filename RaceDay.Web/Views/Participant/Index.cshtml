
@model List<RaceDay.Web.Models.Event>

@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">Participant Dashboard</h1>
        <p class="text-muted">
            Welcome to your RaceDay participant area.
            Discover events and get ready for your next challenge!
        </p>
    </div>

    <div class="row g-3 mb-5">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Your Account</h5>
                    <p class="mb-1">
                        Account type:
                        <strong>@ViewBag.UserRole</strong>
                    </p>
                    <p class="mb-0">
                        Login count:
                        <strong>@ViewBag.LoginCount</strong>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Discover Events</h5>
                    <p class="text-muted">
                        Explore running, walking and cycling events.
                    </p>
                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-dark">
                        Browse All Events
                    </a>
                    <a asp-controller="Participant"
                       asp-action="MyEnrolments"
                       class="btn btn-outline-dark ms-2">
                        My Enrolments
                    </a>
                </div>
            </div>
        </div>
    </div>

    <h3 class="fw-bold mb-3">Available Events</h3>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">

                        @if (!string.IsNullOrEmpty(item.BannerImageUrl))
                        {
                            <img src="@item.BannerImageUrl"
                                 class="card-img-top"
                                 alt="@item.Name"
                                 style="height:180px; object-fit:cover;" />
                        }

                        <div class="card-body">
                            <h5 class="card-title fw-bold">
                                @item.Name
                            </h5>

                            <p class="text-muted">
                                @item.Description
                            </p>

                            <p class="mb-1">
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p class="mb-1">
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p class="mb-0">
                                <strong>Distance:</strong>
                                @item.Distance km
                            </p>
                            <div class="mt-3">
                                <a asp-controller = "Participant"
                                asp-action="Enrol"
                                asp-route-id="@item.EventId"
                                class="btn btn-warning">
                                Enrol Now
                            </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }

</div>
