
@model List<RaceDay.Web.Models.Enrolment>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container py-5">
    <h2 class="mb-4">My Enrolments</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>

        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-dark">
            Browse Events
        </a>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>@enrolment.EventName</td>
                            <td>@enrolment.CategoryName</td>
                            <td>@enrolment.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td>@enrolment.StatusName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
