
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Web.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
            <div class="container">

                <a class="navbar-brand fw-bold fs-3"
                   asp-controller="Home" asp-action="Index">
                    <span class="text-warning">RACE</span>DAY
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#raceDayNavbar"
                        aria-controls="raceDayNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="raceDayNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link px-3"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3"
                               asp-controller="Events"
                               asp-action="Index">
                                Events
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3"
                               href="#about">
                                About
                            </a>
                        </li>

                        <li class="nav-item ms-lg-3">
                            <a class="nav-link"
                                asp-controller="Auth"
                                asp-action="Login">
                                Login
                            </a>
                        </li>

                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                            <a class="nav-link"
                                asp-controller="Auth"
                                asp-action="Register">
                                Register
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white py-4 mt-5">
        <div class="container text-center">

            <h5 class="fw-bold">
                <span class="text-warning">RACE</span>DAY
            </h5>

            <p class="mb-1">
                Connecting runners, walkers and cyclists.
            </p>

            <small class="text-secondary">
                &copy; 2026 RaceDay. All rights reserved.
            </small>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    @await Component.InvokeAsync("UserSession")

</body>
</html>
